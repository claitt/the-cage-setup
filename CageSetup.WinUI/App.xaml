<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CageSetup.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Light + Dark palette (ThemeDictionaries). -->
                <ResourceDictionary Source="ms-appx:///Themes/Palette.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Typography -->
            <Style x:Key="CageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource CageTextBrush}" />
            </Style>
            <Style x:Key="CageSubtitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Foreground" Value="{ThemeResource CageBodyBrush}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="CageMicroStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="200" />
                <Setter Property="Foreground" Value="{ThemeResource CageAccentBrush}" />
            </Style>
            <Style x:Key="CageHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource CageTextBrush}" />
            </Style>

            <!-- Round chip button (back / settings), Windows 11 style.
                 Colors are the constant chip brushes (over the art). -->
            <Style x:Key="CageIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource CageTextBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- Primary action: olive in light, warm cream-taupe in dark. -->
            <Style x:Key="CagePrimaryButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="150" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Padding" Value="20,0" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="{ThemeResource CageAccentBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource CagePrimaryTextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>
                                <Border x:Name="BorderRoot"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{TemplateBinding CornerRadius}">
                                    <ContentPresenter
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Foreground="{TemplateBinding Foreground}"
                                        FontSize="{TemplateBinding FontSize}"
                                        FontWeight="{TemplateBinding FontWeight}"
                                        Padding="{TemplateBinding Padding}"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center" />
                                </Border>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.12" />
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BorderRoot"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="{ThemeResource CageAccentHoverColor}" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BorderRoot"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="{ThemeResource CageAccentPressedColor}" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="0.985" Duration="0:0:0.08" />
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="0.985" Duration="0:0:0.08" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="BorderRoot"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.42" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Hyperlink-style text button (Check again / Show log). -->
            <Style x:Key="CageLinkButtonStyle" TargetType="HyperlinkButton">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{ThemeResource CageLinkBrush}" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- Small inconspicuous action button used inside step pages
                 (Refresh, secondary actions): soft accent pill. -->
            <Style x:Key="CageSoftButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource CageCardBorderBrush}" />
                <Setter Property="Background" Value="{ThemeResource CageAccentSoftBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource CageAccentBrush}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- Row action (Fix / Select APK): same soft-button look as
                 "Refresh state" and "Choose local files". -->
            <Style x:Key="CageRowActionButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource CageSoftButtonStyle}">
                <Setter Property="MinWidth" Value="96" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
