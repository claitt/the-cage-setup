<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CageSetup.WinUI.Controls.CheckRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinHeight="54">

    <Grid x:Name="LayoutRoot" Background="Transparent" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <FontIcon x:Name="IconGlyph"
                  Grid.Column="0"
                  FontSize="15"
                  Foreground="{ThemeResource CageAccentBrush}"
                  Margin="0,0,16,0"
                  VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="TitleText"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource CageTextBrush}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="DetailText"
                       FontSize="12"
                       Foreground="{ThemeResource CageBodyBrush}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Button x:Name="ActionButton"
                Grid.Column="2"
                Style="{ThemeResource CageSoftButtonStyle}"
                Visibility="Collapsed"
                VerticalAlignment="Center"
                Margin="0,0,12,0"
                Click="ActionButton_Click" />

        <Border x:Name="Pill"
                Grid.Column="3"
                CornerRadius="4"
                Padding="9,3"
                Background="{ThemeResource CagePendingSoftBrush}"
                VerticalAlignment="Center">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <TextBlock x:Name="PillText"
                       FontSize="11"
                       FontWeight="SemiBold"
                       CharacterSpacing="60"
                       Foreground="{ThemeResource CagePendingBrush}"
                       Text="PENDING" />
        </Border>
    </Grid>
</UserControl>
