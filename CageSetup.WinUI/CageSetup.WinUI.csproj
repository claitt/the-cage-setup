<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>CageSetup.WinUI</RootNamespace>
    <AssemblyName>TheCageSetup</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Lunar_Tear.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)'=='' or '$(Platform)'=='AnyCPU'">x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)'==''">true</SelfContained>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>2.1.4</Version>
    <Product>Lunar Tear - The Cage Setup</Product>
    <Authors>Lunar Tear</Authors>
    <SatelliteResourceLanguages>en;it;de;fr;ru;ja</SatelliteResourceLanguages>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <NoWarn>$(NoWarn);CA1416;CS0169;CS0649</NoWarn>
  </PropertyGroup>

  <!-- The Windows App SDK ships an AI/ONNX runtime that this app never
       loads. Drop it before the single-file bundle is produced. -->
  <Target Name="DropUnusedPayload" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '^(onnxruntime|onnxruntime_providers_shared|DirectML|Microsoft\.ML\.OnnxRuntime|Microsoft\.Windows\.AI.*|NPUDetect)$'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CageSetup.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
