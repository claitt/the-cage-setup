<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CageSetup.WinUI.Pages.Step2Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CageSetup.WinUI.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Emulator status rows. -->
        <Grid x:Name="RowsHost" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
        </Grid>

        <!-- Shared action strip: progress, install/cancel/refresh. -->
        <controls:ActionPanel x:Name="Actions" Grid.Row="1" />
    </Grid>
</Page>
