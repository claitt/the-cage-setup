<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CageSetup.WinUI.Pages.Step3Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CageSetup.WinUI.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Game files status rows. -->
        <Grid x:Name="RowsHost" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
        </Grid>

        <!-- Point the setup at a folder that already holds the files. -->
        <Button x:Name="ChooseFolderButton"
                Grid.Row="1"
                Style="{ThemeResource CageSoftButtonStyle}"
                Content="Choose local files"
                HorizontalAlignment="Left"
                Margin="0,10,0,0"
                Click="ChooseFolderButton_Click" />

        <!-- Shared action strip: progress, download/cancel/refresh. -->
        <controls:ActionPanel x:Name="Actions" Grid.Row="2" />
    </Grid>
</Page>
